// Project Expense Manager — Phase 1 schema (see docs/DATABASE.md)
//
// This file targets PostgreSQL (production) and is the source of truth.
// For local dev on SQLite, `scripts/prisma.mjs` derives prisma/sqlite/schema.prisma
// from it (provider swapped, @db.* native types stripped) when DATABASE_PROVIDER=sqlite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ACCOUNTANT
  SITE_INCHARGE
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum VendorType {
  SUPPLIER
  CONTRACTOR
  OTHER
}

enum Trade {
  MASON
  ELECTRICIAN
  PLUMBER
  HELPER
  CARPENTER
  AC_TECHNICIAN
  CEILING_WORKER
  TILE_WORKER
  OTHER
}

enum RateType {
  DAILY
  MONTHLY
}

// Labour = daily/monthly wage workers; Permanent / Part-time = salaried staff (payroll).
enum EmployeeType {
  LABOUR
  PERMANENT
  PART_TIME
}

// Employee cash ledger (client change: "record of expenses by employees").
enum CashEntryType {
  OPENING // previous balance in hand
  ISSUED // funds given to the employee
  RETURNED // unspent cash handed back to the company
}

// Office attendance (changes/changes.pdf §3). Unmarked days: unpaid for daily-rate workers,
// paid for monthly staff.
enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
  LEAVE
}

// Pay added to or taken off an employee's monthly wages (changes/changes.pdf §3:
// "benefit / rewards, incentives, deductions and advance payments").
enum PayAdjustmentType {
  BENEFIT
  REWARD
  INCENTIVE
  DEDUCTION
  ADVANCE_RECOVERY // repays an advance (advances themselves are expenses under "Advance to labour")
}

enum PaymentMode {
  CASH
  ONLINE_TRANSFER
  BANK_TRANSFER
  CHEQUE
  JAZZCASH
  EASYPAISA
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  LOGIN
}

model User {
  id                 Int      @id @default(autoincrement())
  name               String
  username           String   @unique
  email              String?  @unique
  passwordHash       String   @map("password_hash")
  role               Role
  isActive           Boolean  @default(true) @map("is_active")
  // Forces a password change on next login (used for the seeded admin / admin resets)
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  projects         ProjectUser[]
  employee         Worker?
  cashEntries      CashEntry[]
  attendanceMarked Attendance[]
  payAdjustments   PayAdjustment[]
  expensesCreated  Expense[]     @relation("ExpenseCreatedBy")
  expensesApproved Expense[]     @relation("ExpenseApprovedBy")
  attachments      Attachment[]
  activityLogs     ActivityLog[]

  @@map("users")
}

model Project {
  id             Int           @id @default(autoincrement())
  code           String        @unique
  name           String
  clientName     String?       @map("client_name")
  projectManager String?       @map("project_manager")
  location       String?
  startDate      DateTime      @map("start_date") @db.Date
  endDate        DateTime?     @map("end_date") @db.Date
  status         ProjectStatus @default(ACTIVE)
  budget         Decimal?      @db.Decimal(14, 2)
  isHeadOffice   Boolean       @default(false) @map("is_head_office")
  // A branch / regional office: a cost center for its overheads and staff salaries, not a client job
  isSubOffice    Boolean       @default(false) @map("is_sub_office")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  users          ProjectUser[]
  expenses       Expense[]
  defaultWorkers Worker[]
  cashEntries    CashEntry[]

  @@map("projects")
}

model ProjectUser {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@map("project_users")
}

model ExpenseHead {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subheads ExpenseSubhead[]
  expenses Expense[]

  @@map("expense_heads")
}

model ExpenseSubhead {
  id        Int      @id @default(autoincrement())
  headId    Int      @map("head_id")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  head     ExpenseHead @relation(fields: [headId], references: [id])
  expenses Expense[]

  @@unique([headId, name])
  @@map("expense_subheads")
}

model Vendor {
  id        Int        @id @default(autoincrement())
  name      String
  type      VendorType
  phone     String?
  ntn       String?
  address   String?
  notes     String?
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")

  expenses Expense[]

  @@map("vendors")
}

model Worker {
  id               Int       @id @default(autoincrement())
  name             String
  cnic             String?
  phone            String?
  employeeType     EmployeeType @default(LABOUR) @map("employee_type")
  designation      String?
  trade            Trade
  rateType         RateType  @map("rate_type")
  rate             Decimal   @db.Decimal(12, 2)
  defaultProjectId Int?      @map("default_project_id")
  // Login account of this employee, e.g. a site in-charge who spends from their own cash in hand
  userId           Int?      @unique @map("user_id")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  defaultProject Project?    @relation(fields: [defaultProjectId], references: [id])
  user           User?       @relation(fields: [userId], references: [id])
  expenses       Expense[]
  // Expenses this employee paid out of the cash they hold
  cashExpenses   Expense[]   @relation("ExpensePaidFrom")
  cashEntries    CashEntry[]
  attendance     Attendance[]
  payAdjustments PayAdjustment[]

  @@map("workers")
}

model Expense {
  id              Int           @id @default(autoincrement())
  expenseNo       String        @unique @map("expense_no")
  date            DateTime      @db.Date
  projectId       Int           @map("project_id")
  headId          Int           @map("head_id")
  subheadId       Int           @map("subhead_id")
  // Gross bill amount (the project's cost). GST is the part of it that is sales tax; withholding
  // tax is deducted when paying, so the payee receives amount - whtAmount.
  amount          Decimal       @db.Decimal(14, 2)
  gstAmount       Decimal?      @map("gst_amount") @db.Decimal(14, 2)
  whtAmount       Decimal?      @map("wht_amount") @db.Decimal(14, 2)
  paymentMode     PaymentMode   @map("payment_mode")
  chequeNo        String?       @map("cheque_no")
  paidTo          String        @map("paid_to")
  vendorId        Int?          @map("vendor_id")
  workerId        Int?          @map("worker_id")
  // Set when an employee paid this from the cash they hold; null = paid by the company directly
  paidFromId      Int?          @map("paid_from_id")
  referenceNo     String?       @map("reference_no")
  description     String
  status          ExpenseStatus @default(PENDING)
  rejectionReason String?       @map("rejection_reason")
  approvedById    Int?          @map("approved_by")
  approvedAt      DateTime?     @map("approved_at")
  splitGroupId    String?       @map("split_group_id") @db.Uuid
  createdById     Int           @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  project     Project        @relation(fields: [projectId], references: [id])
  head        ExpenseHead    @relation(fields: [headId], references: [id])
  subhead     ExpenseSubhead @relation(fields: [subheadId], references: [id])
  vendor      Vendor?        @relation(fields: [vendorId], references: [id])
  worker      Worker?        @relation(fields: [workerId], references: [id])
  paidFrom    Worker?        @relation("ExpensePaidFrom", fields: [paidFromId], references: [id])
  approvedBy  User?          @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  createdBy   User           @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  attachments Attachment[]

  @@index([projectId, date])
  @@index([headId, date])
  @@index([status])
  @@index([vendorId])
  @@index([workerId])
  @@index([paidFromId])
  @@index([splitGroupId])
  @@map("expenses")
}

// Money moving between the company and an employee's cash in hand. Spending from that cash
// is recorded as expenses with paid_from_id set, so the balance is
//   opening + issued - returned - approved expenses paid from it.
model CashEntry {
  id          Int           @id @default(autoincrement())
  entryNo     String        @unique @map("entry_no")
  date        DateTime      @db.Date
  workerId    Int           @map("worker_id")
  type        CashEntryType
  amount      Decimal       @db.Decimal(14, 2)
  paymentMode PaymentMode   @map("payment_mode")
  projectId   Int?          @map("project_id")
  referenceNo String?       @map("reference_no")
  notes       String?
  createdById Int           @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  worker    Worker   @relation(fields: [workerId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([workerId, date])
  @@map("cash_entries")
}

// One row per employee per day; clearing a mark deletes the row (changes are in the activity log).
model Attendance {
  id         Int              @id @default(autoincrement())
  date       DateTime         @db.Date
  workerId   Int              @map("worker_id")
  status     AttendanceStatus
  markedById Int              @map("marked_by")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  worker   Worker @relation(fields: [workerId], references: [id])
  markedBy User   @relation(fields: [markedById], references: [id])

  @@unique([workerId, date])
  @@index([date])
  @@map("attendance")
}

model PayAdjustment {
  id          Int               @id @default(autoincrement())
  entryNo     String            @unique @map("entry_no")
  date        DateTime          @db.Date
  workerId    Int               @map("worker_id")
  type        PayAdjustmentType
  amount      Decimal           @db.Decimal(14, 2)
  notes       String?
  createdById Int               @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")

  worker    Worker @relation(fields: [workerId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([workerId, date])
  @@map("pay_adjustments")
}

model Attachment {
  id           Int      @id @default(autoincrement())
  expenseId    Int      @map("expense_id")
  fileName     String   @map("file_name")
  filePath     String   @map("file_path")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  uploadedById Int      @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  expense    Expense @relation(fields: [expenseId], references: [id])
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  @@index([expenseId])
  @@map("attachments")
}

model ActivityLog {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  action     LogAction
  entityType String    @map("entity_type")
  entityId   Int       @map("entity_id")
  changes    Json?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
