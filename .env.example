# ---- Database ----------------------------------------------------------------
# Production: PostgreSQL
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://pem:pem_password@localhost:5432/project_expense_manager?schema=public

# Local development on SQLite instead (no Postgres needed):
# DATABASE_PROVIDER=sqlite
# DATABASE_URL=file:./dev.db

# ---- Sessions ----------------------------------------------------------------
# At least 32 random characters. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# Set to "true" when served over HTTPS (marks the session cookie Secure)
SESSION_COOKIE_SECURE=false

# ---- App URL -----------------------------------------------------------------
# Public address of the app; used to make expense numbers clickable in Excel exports.
APP_URL=https://expenses.example.com

# ---- File uploads ------------------------------------------------------------
# Receipts and the company logo are stored here (outside /public; served only to logged-in users)
UPLOAD_DIR=./uploads

# ---- Cloud file storage (Cloudflare R2) --------------------------------------
# When all four are set, receipts and the logo go to this private R2 bucket instead of
# UPLOAD_DIR. Required on Vercel (its disk is read-only). Create an R2 API token with
# "Object Read & Write" on the bucket.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# ---- Backups (scripts/backup.sh) --------------------------------------------
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
